{
  "name": "conductvac",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vacuum system builder & pump-down simulator — regime-aware gas dynamics in the browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vitest run src/engine/tests/demo.headless.test.ts",
    "smoke": "node scripts/smoke/smoke.mjs",
    "build:portable": "node scripts/build-portable.mjs",
    "lint": "eslint .",
    "smoke:portable": "node scripts/smoke/portable.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uplot": "^1.6.31",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
